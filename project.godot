; Blisterborn — prototipo Godot 2D
config_version=5

[application]

config/name="Blisterborn"
config/description="Un trekking a bivi"
config/version="0.2.0"
run/main_scene="res://godot/scenes/main.tscn"

[autoload]

GameState="*res://godot/scripts/game_state.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[gui]

theme/default_font_multichannel_signed_distance_field=true

